# Copy this file to .env.local (git-ignored) and adjust if your backend
# isn't running at the default location.
#
# The backend (see ../backend or ../docker-compose.yml) listens on :8000
# and already allows CORS from http://localhost:3000 by default
# (see backend/.env.example -> BACKEND_CORS_ORIGINS).
NEXT_PUBLIC_API_URL=http://localhost:8000
